# Copy to .env and fill in: cp .env.example .env
# Never commit .env.

# LangSmith (smith.langchain.com → Settings → API Keys).
# Create the key inside the same workspace as LANGSMITH_WORKSPACE_ID.
LANGSMITH_API_KEY=
# LangSmith workspace ID (Settings → Workspaces). Required for deploys and
# `mda connections` commands.
LANGSMITH_WORKSPACE_ID=

# Anthropic API key (console.anthropic.com). Powers the agent's model.
ANTHROPIC_API_KEY=

# The GitHub repository the agent works on, as owner/name.
# Must be public so the sandbox can clone it.
PATCH_REPO=

# Fine-grained GitHub token scoped ONLY to PATCH_REPO, with
# Contents + Pull requests set to "Read and write" (read-only fails with 403).
# - Locally (`mda dev`), the `patch-github` connection reads it from here.
# - For a deployment, store it in LangSmith once:
#     uv run mda connections create patch-github --secret-from-env MDA_DEV_PATCH_GITHUB
MDA_DEV_PATCH_GITHUB=

# Slack needs nothing here: `mda deploy` creates and installs the Slack app.
